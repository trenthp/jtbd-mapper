# Postgres connection string (Neon via Vercel, or any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: direct (non-pooled) connection used only by `vercel-build` for
# migrations. Neon's pooler breaks Prisma's migration lock. The Neon Vercel
# integration sets this automatically; falls back to DATABASE_URL if unset.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
